#RESET
reset;

#load the model
model W4_Quiz2.mod;

#load the data:
data W4_Quiz2.dat;

#change the colver (optional)
option solver CPLEX;

#solve
solve;

#Show results:
display x;
display Cost;

#Other options to display:
show TotalCost,PayBackLiability;
display TotalCost, PayBackLiability;