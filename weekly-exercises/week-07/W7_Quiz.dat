

param U:= 3; #3 types of securities
param I:= 2;
param J:= 2;


#Rival rate of return for security u in scenario i
param u_i:
	1		2:=
1	1.03	1.01
2	1.04	0.96
3	1.05	0.99;

#Variance Covariance Matrix in scenario 1
param VC_Matrix_S1:
	1		2		3 :=
1	1		0.1		-0.1
2	0.1		1		0.1
3	-0.1	0.1		1;

#Variance Covariance Matrix in scenario 2
param VC_Matrix_S2:
	1		2		3 :=
1	2		-0.5	0.5
2	-0.5	3		0.5
3	0.5		0.5		4;

#Range for Risk aversion parameter Alpha from 0 to 1 by 0.1
param AlphaRange:=
1	0
2	0.1
3	0.2
4	0.3
5	0.4
6	0.5
7	0.6
8	0.7
9	0.8
10	0.9
11	1.0;





